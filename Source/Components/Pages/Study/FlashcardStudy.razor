@page "/study/flashcards"
@page "/study/flashcards/{TopicIdRoute:int?}"
@rendermode InteractiveServer
@inject IStudyService StudyService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager

<PageTitle>Flashcard 3D - Học Từ Vựng 📘</PageTitle>

<div class="container py-3" style="max-width: 800px;">
    <!-- #region: Top Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <a href="/study" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Trở về Hub
        </a>

        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-dark border px-3 py-2">
                <i class="bi bi-card-text text-primary me-1"></i>
                @if (words.Count > 0)
                {
                    <span>Từ <strong>@(currentIndex + 1)</strong> / @words.Count</span>
                }
                else
                {
                    <span>0 từ</span>
                }
            </span>
        </div>
    </div>

    @if (words.Count > 0)
    {
        <!-- Progress Bar -->
        <div class="progress-container mb-4" style="height: 6px;">
            <div class="progress-bar-gradient h-100" style="width: @(progressPercent)%"></div>
        </div>
    }
    <!-- #endregion: Top Bar -->

    @if (isLoading)
    {
        <LoadingSpinner IsVisible="true" Message="Đang chuẩn bị bộ thẻ Flashcard..." />
    }
    else if (words.Count == 0)
    {
        <div class="card border rounded-3 p-5 text-center bg-white shadow-sm">
            <div class="display-3 text-muted mb-3">
                <i class="bi bi-emoji-smile"></i>
            </div>
            <h4 class="fw-bold text-dark">Không tìm thấy từ vựng nào!</h4>
            <p class="text-muted">
                Có thể tất cả từ trong chủ đề này đã được đánh dấu là "Đã thuộc", hoặc chủ đề chưa có từ vựng.
            </p>
            <div class="mt-3">
                <a href="/study" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại chọn chủ đề khác
                </a>
            </div>
        </div>
    }
    else if (isCompleted)
    {
        <!-- #region: Completion Screen -->
        <div class="card border rounded-4 p-5 text-center bg-white shadow-sm">
            <div class="display-1 text-warning mb-3">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Tuyệt vời! Bạn đã hoàn thành phiên học 🎉</h2>
            <p class="text-muted mb-4">
                Bạn đã lướt qua toàn bộ <strong>@words.Count</strong> thẻ từ vựng trong lượt này.
            </p>

            <div class="row g-3 justify-content-center mb-4" style="max-width: 500px; margin: 0 auto;">
                <div class="col-6">
                    <div class="card bg-success-subtle border-0 p-3 rounded-3">
                        <h3 class="fw-bold text-success mb-0">@sessionMasteredCount</h3>
                        <small class="text-success fw-semibold">Đã đánh dấu thuộc</small>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card bg-warning-subtle border-0 p-3 rounded-3">
                        <h3 class="fw-bold text-warning mb-0">@(words.Count - sessionMasteredCount)</h3>
                        <small class="text-warning fw-semibold">Cần ôn lại</small>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-center gap-2">
                <button class="btn btn-primary px-4 py-2" @onclick="RestartSessionAsync">
                    <i class="bi bi-arrow-repeat me-1"></i> Học lại danh sách này
                </button>
                <a href="/study" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-house me-1"></i> Trở về Trung tâm
                </a>
            </div>
        </div>
        <!-- #endregion: Completion Screen -->
    }
    else
    {
        var currentWord = words[currentIndex];

        <!-- #region: 3D Flashcard Presentation -->
        <div class="flashcard-scene mb-4">
            <div class="@(isFlipped ? "flashcard-inner is-flipped" : "flashcard-inner")" @onclick="ToggleFlip">
                <!-- Front Side -->
                <div class="flashcard-face flashcard-front">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-1">
                            <i class="bi bi-bookmark me-1"></i>@(currentWord.Topic?.Name ?? "Chung")
                        </span>

                        <button type="button" class="speaker-btn" title="Phát âm từ này"
                                @onclick:stopPropagation="true" @onclick="() => SpeakTermAsync(currentWord.Term)">
                            <i class="bi bi-volume-up-fill fs-5"></i>
                        </button>
                    </div>

                    <div class="text-center my-auto py-4">
                        <h1 class="display-4 fw-bold text-primary mb-2">@currentWord.Term</h1>
                        @if (!string.IsNullOrWhiteSpace(currentWord.Phonetic))
                        {
                            <div class="text-muted fs-5 font-monospace mb-2">@currentWord.Phonetic</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(currentWord.PartOfSpeech))
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                @currentWord.PartOfSpeech
                            </span>
                        }
                    </div>

                    <div class="text-center text-muted small">
                        <i class="bi bi-arrow-repeat me-1"></i> Nhấp chuột vào thẻ để xem nghĩa (Mặt sau)
                    </div>
                </div>

                <!-- Back Side -->
                <div class="flashcard-face flashcard-back">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge bg-purple-subtle text-purple rounded-pill px-3 py-1">
                            Ý nghĩa & Ví dụ
                        </span>

                        <button type="button" class="speaker-btn" title="Phát âm từ này"
                                @onclick:stopPropagation="true" @onclick="() => SpeakTermAsync(currentWord.Term)">
                            <i class="bi bi-volume-up-fill fs-5"></i>
                        </button>
                    </div>

                    <div class="text-center my-auto py-3">
                        <h2 class="fw-bold text-dark mb-3">@currentWord.Meaning</h2>

                        @if (!string.IsNullOrWhiteSpace(currentWord.ExampleSentence))
                        {
                            <div class="p-3 bg-white border rounded-3 text-start mx-auto mt-2" style="max-width: 480px;">
                                <div class="text-primary fw-medium small mb-1">
                                    <i class="bi bi-chat-left-quote me-1"></i> Ví dụ câu:
                                </div>
                                <div class="fst-italic text-dark mb-1">"@currentWord.ExampleSentence"</div>
                                @if (!string.IsNullOrWhiteSpace(currentWord.ExampleTranslation))
                                {
                                    <div class="text-muted small">→ @currentWord.ExampleTranslation</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="text-center text-muted small">
                        <i class="bi bi-arrow-repeat me-1"></i> Nhấp chuột vào thẻ để quay lại mặt trước
                    </div>
                </div>
            </div>
        </div>
        <!-- #endregion: 3D Flashcard Presentation -->

        <!-- #region: Controls Toolbar -->
        <div class="d-flex flex-wrap align-items-center justify-content-center gap-3">
            <button class="btn btn-outline-secondary px-3" disabled="@(currentIndex == 0)" @onclick="PrevCard">
                <i class="bi bi-chevron-left me-1"></i> Từ trước
            </button>

            <button class="btn btn-outline-warning text-dark px-3" @onclick="() => MarkMasteryAsync(false)">
                <i class="bi bi-hourglass-split me-1 text-warning"></i> Chưa nhớ
            </button>

            <button class="btn btn-outline-primary px-3" @onclick="ToggleFlip">
                <i class="bi bi-arrow-repeat me-1"></i> Lật thẻ
            </button>

            <button class="btn btn-success px-4" @onclick="() => MarkMasteryAsync(true)">
                <i class="bi bi-check-circle-fill me-1"></i> Đã nhớ từ này
            </button>

            <button class="btn btn-outline-secondary px-3" @onclick="NextCard">
                Từ tiếp theo <i class="bi bi-chevron-right ms-1"></i>
            </button>
        </div>
        <!-- #endregion: Controls Toolbar -->
    }
</div>

@code {
    #region Parameters

    /// <summary>
    /// Optional topic identifier passed via URL route segment.
    /// </summary>
    [Parameter]
    public int? TopicIdRoute { get; set; }

    /// <summary>
    /// Target topic identifier passed via query string.
    /// </summary>
    [SupplyParameterFromQuery]
    public int? TopicId { get; set; }

    /// <summary>
    /// Filter to include unmastered words only.
    /// </summary>
    [SupplyParameterFromQuery]
    public bool? Unmastered { get; set; }

    /// <summary>
    /// Maximum count of words for the study session.
    /// </summary>
    [SupplyParameterFromQuery]
    public int? Count { get; set; }

    #endregion

    #region State

    private bool isLoading = true;
    private bool isCompleted = false;
    private bool isFlipped = false;
    private int currentIndex = 0;
    private int sessionMasteredCount = 0;
    private List<Word> words = new();

    private int progressPercent => words.Count > 0 ? (int)Math.Round((double)(currentIndex + 1) / words.Count * 100) : 0;

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        await LoadWordsAsync();
    }

    #endregion

    #region Methods

    private async Task LoadWordsAsync()
    {
        isLoading = true;
        try
        {
            int? effectiveTopicId = TopicIdRoute ?? (TopicId > 0 ? TopicId : null);
            var options = new StudySessionOptions
            {
                TopicId = effectiveTopicId,
                OnlyUnmastered = Unmastered ?? true,
                ItemCount = Count ?? 20
            };

            words = await StudyService.GetWordsForStudyAsync(options);
            currentIndex = 0;
            isFlipped = false;
            isCompleted = false;
            sessionMasteredCount = 0;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ToggleFlip()
    {
        isFlipped = !isFlipped;
    }

    private async Task SpeakTermAsync(string term)
    {
        try
        {
            await JS.InvokeVoidAsync("studyInterop.speakWord", term, "en-US");
        }
        catch
        {
            // Ignore speech synthesis errors gracefully
        }
    }

    private async Task MarkMasteryAsync(bool isMastered)
    {
        if (currentIndex < words.Count)
        {
            var word = words[currentIndex];
            word.IsMastered = isMastered;

            // Persist mastery state into database
            await StudyService.SetWordMasteryAsync(word.Id, isMastered);

            if (isMastered)
            {
                sessionMasteredCount++;
                try
                {
                    await JS.InvokeVoidAsync("studyInterop.playSound", "success");
                }
                catch { }
            }

            NextCard();
        }
    }

    private void PrevCard()
    {
        if (currentIndex > 0)
        {
            currentIndex--;
            isFlipped = false;
        }
    }

    private void NextCard()
    {
        if (currentIndex < words.Count - 1)
        {
            currentIndex++;
            isFlipped = false;
        }
        else
        {
            isCompleted = true;
            try
            {
                _ = JS.InvokeVoidAsync("studyInterop.playSound", "complete");
            }
            catch { }
        }
    }

    private async Task RestartSessionAsync()
    {
        await LoadWordsAsync();
    }

    #endregion
}

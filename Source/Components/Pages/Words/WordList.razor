    private void OpenDeleteModal(Word word)
    {
        wordToDelete = word;
        deleteWarningMessage = $"Bạn có chắc chắn muốn xóa từ '{word.Term}' không? Hành động này không thể hoàn tác.";
        isDeleteModalVisible = true;
    }

    private async Task ConfirmDeleteWordAsync()
    {
        if (wordToDelete == null) return;
        isDeleting = true;

        try
        {
            var term = wordToDelete.Term;
            await VocabularyService.DeleteWordAsync(wordToDelete.Id);
            isDeleteModalVisible = false;
            wordToDelete = null;
            ShowAlert($"Đã xóa từ '{term}' thành công!", isSuccess: true);
            await LoadWordsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi khi xóa từ vựng: {ex.Message}", isSuccess: false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowAlert(string message, bool isSuccess)
    {
        alertMessage = message;
        alertType = isSuccess ? AlertType.Success : AlertType.Error;
    }

    private string GetDisplayCountText()
    {
        if (totalCount == 0) return "0 từ";
        return $"Hiển thị {words.Count} / {totalCount} từ";
    }

    /// <summary>
    /// Maps part-of-speech values to Bootstrap badge CSS classes for visual differentiation.
    /// </summary>
    private string GetPartOfSpeechBadgeClass(string? pos)
    {
        return (pos?.ToLower().Trim()) switch
        {
            "noun" or "danh từ" => "bg-primary-subtle text-primary border border-primary-subtle",
            "verb" or "động từ" => "bg-success-subtle text-success border border-success-subtle",
            "adjective" or "adj" or "tính từ" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
            "adverb" or "adv" or "trạng từ" => "bg-info-subtle text-info-emphasis border border-info-subtle",
            "phrase" or "cụm từ" => "bg-purple-subtle text-purple border border-purple-subtle",
            _ => "bg-secondary-subtle text-secondary border border-secondary-subtle"
        };
    }

    private static string Truncate(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return string.Empty;
        return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
    }

    // ─── Import / Export Logic ──────────────────────────
    private async Task ExportCsvAsync()
    {
        if (isExporting) return;
        isExporting = true;
        try
        {
            var bytes = await VocabularyService.ExportWordsToCsvAsync();
            var base64 = Convert.ToBase64String(bytes);
            var url = $"data:text/csv;base64,{base64}";
            await JS.InvokeVoidAsync("downloadFileFromBase64", "words_export.csv", url);
            ShowAlert("Xuất file CSV thành công!", true);
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi xuất file: {ex.Message}", false);
        }
        finally
        {
            isExporting = false;
        }
    }

    private void OpenImportModal()
    {
        importBrowserFile = null;
        isImportModalVisible = true;
    }

    private void CloseImportModal()
    {
        isImportModalVisible = false;
        importBrowserFile = null;
    }

    private async Task DownloadTemplateAsync()
    {
        var headers = "TopicName,Term,Meaning,Pronunciation,PartOfSpeech,Example,ExampleTranslation,IsMastered\nChủ đề mẫu,Hello,Xin chào,həˈloʊ,noun,Hello world,Chào thế giới,false";
        // Use UTF8 with BOM for Excel
        var preamble = System.Text.Encoding.UTF8.GetPreamble();
        var bytes = System.Text.Encoding.UTF8.GetBytes(headers);
        var finalBytes = preamble.Concat(bytes).ToArray();
        var base64 = Convert.ToBase64String(finalBytes);
        var url = $"data:text/csv;base64,{base64}";
        await JS.InvokeVoidAsync("downloadFileFromBase64", "template.csv", url);
    }

    private void LoadImportFile(InputFileChangeEventArgs e)
    {
        importBrowserFile = e.File;
    }

    private async Task ProcessImportAsync()
    {
        if (importBrowserFile == null) return;
        isImporting = true;
        try
        {
            // Limit to 5MB
            using var stream = importBrowserFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            var result = await VocabularyService.ImportWordsFromCsvAsync(stream);
            
            CloseImportModal();
            
            if (result.errorCount == -1)
            {
                ShowAlert("Lỗi định dạng file hoặc cấu trúc CSV không đúng.", false);
            }
            else
            {
                ShowAlert($"Import hoàn tất. Thành công: {result.successCount} từ. Lỗi/bỏ qua: {result.errorCount} dòng.", result.successCount > 0);
            }
            
            if (result.successCount > 0)
            {
                await LoadTopicsAsync();
                await LoadWordsAsync();
            }
        }
        catch (Exception ex)
        {
            CloseImportModal();
            ShowAlert($"Lỗi khi import file: {ex.Message}", false);
        }
        finally
        {
            isImporting = false;
        }
    }

    public void Dispose()
    {
        debounceTimer?.Stop();
        debounceTimer?.Dispose();
    }
}

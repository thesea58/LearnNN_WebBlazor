@page "/words"
@rendermode InteractiveServer
@inject IVocabularyService VocabularyService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Danh sách từ vựng - LearnNN 📝</PageTitle>

<div class="container-fluid p-0">
    <!-- #region: Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>Danh sách Từ vựng
            </h2>
            <p class="text-muted mb-0">
                Quản lý, tra cứu và theo dõi mức độ ghi nhớ vốn từ của bạn
            </p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-success rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenImportModal">
                <i class="bi bi-box-arrow-in-down"></i>
                <span class="d-none d-sm-inline">Import</span>
            </button>
            <button class="btn btn-outline-info rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="ExportCsvAsync" disabled="@isExporting">
                <i class="bi bi-box-arrow-up"></i>
                <span class="d-none d-sm-inline">Export</span>
            </button>
            <button class="btn btn-primary rounded-pill px-3 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenAddModal">
                <i class="bi bi-plus-circle-fill"></i>
                <span class="d-none d-sm-inline">Thêm từ mới</span>
            </button>
        </div>
    </div>
    <!-- #endregion: Page Header -->

    <!-- #region: Alert Notification -->
    <AlertMessage Message="@alertMessage"
                  Type="@alertType"
                  IsVisible="@(!string.IsNullOrEmpty(alertMessage))"
                  OnDismiss="() => alertMessage = null" />
    <!-- #endregion: Alert Notification -->

    <!-- #region: Filter & Search Toolbar -->
    <div class="card border rounded-3 bg-white shadow-sm p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" 
                           class="form-control border-start-0 border-end-0 ps-0" 
                           placeholder="Tìm theo từ vựng hoặc nghĩa..." 
                           value="@searchTerm" 
                           @oninput="OnSearchInputChanged" />
                    @if (!string.IsNullOrWhiteSpace(searchTerm))
                    {
                        <button class="btn btn-white border border-start-0 text-muted" type="button" @onclick="ClearSearch" title="Xóa tìm kiếm">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>

            <div class="col-6 col-md-3">
                <select class="form-select" @onchange="OnTopicFilterChanged" value="@(selectedTopicId?.ToString() ?? "0")">
                    <option value="0">📁 Tất cả chủ đề</option>
                    @foreach (var topic in topics)
                    {
                        <option value="@topic.Id">@topic.Name</option>
                    }
                </select>
            </div>

            <div class="col-6 col-md-3">
                <select class="form-select" @onchange="OnMasteredFilterChanged" value="@((int)selectedMasteredFilter)">
                    <option value="0">🏷️ Tất cả trạng thái</option>
                    <option value="1">⏳ Chưa thuộc</option>
                    <option value="2">✅ Đã thuộc</option>
                </select>
            </div>

            <div class="col-12 col-md-1 text-md-end">
                @if (HasActiveFilters)
                {
                    <button class="btn btn-outline-secondary w-100 px-2" @onclick="ResetFilters" title="Đặt lại tất cả bộ lọc">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                }
            </div>
        </div>
    </div>
    <!-- #endregion: Filter & Search Toolbar -->

    <!-- #region: Word List Table -->
    <div class="card border rounded-3 bg-white shadow-sm overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi @(currentViewMode == ViewMode.Table ? "bi-table" : "bi-grid-3x3-gap-fill") me-2 text-primary"></i>Kho từ vựng
                </h6>
                @if (!isLoading)
                {
                    <span class="badge bg-light text-secondary border rounded-pill">
                        @GetDisplayCountText()
                    </span>
                }
            </div>

            <div class="d-flex align-items-center gap-3 w-100 w-sm-auto justify-content-between justify-content-sm-end">
                @if (totalPages > 1)
                {
                    <span class="text-muted small">
                        Trang <strong>@currentPage</strong> / <strong>@totalPages</strong>
                    </span>
                }
                <ViewModeSwitcher CurrentMode="@currentViewMode" CurrentModeChanged="OnViewModeChangedAsync" />
            </div>
        </div>

        @if (isLoading)
        {
            <LoadingSpinner IsVisible="@isLoading" Message="Đang tải danh sách từ vựng..." />
        }
        else if (!words.Any())
        {
            <div class="p-5 text-center">
                @if (HasActiveFilters)
                {
                    <div class="display-6 text-muted mb-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Không tìm thấy từ vựng nào</h5>
                    <p class="text-muted mx-auto mb-3" style="max-width: 450px;">
                        Không có từ vựng nào khớp với điều kiện tìm kiếm hoặc bộ lọc hiện tại của bạn.
                    </p>
                    <button class="btn btn-outline-primary rounded-pill px-4" @onclick="ResetFilters">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                    </button>
                }
                else
                {
                    <div class="display-6 text-muted mb-3">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <h5 class="fw-bold text-dark">Chưa có từ vựng nào</h5>
                    <p class="text-muted mx-auto mb-3" style="max-width: 450px;">
                        Kho từ vựng đang trống. Hãy thêm từ vựng đầu tiên để bắt đầu hành trình học tập!
                    </p>
                    <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenAddModal">
                        <i class="bi bi-plus-circle-fill me-1"></i> Thêm từ đầu tiên
                    </button>
                }
            </div>
        }
        else
        {
            @if (currentViewMode == ViewMode.Table)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 55px;">#</th>
                                <th style="min-width: 170px;">Từ vựng</th>
                                <th style="width: 130px;">Phiên âm</th>
                                <th style="width: 110px;">Từ loại</th>
                                <th style="min-width: 220px;">Nghĩa</th>
                                <th style="min-width: 220px;">Ví dụ</th>
                                <th style="min-width: 140px;">Chủ đề</th>
                                <th class="text-center" style="width: 140px;">Trạng thái</th>
                                <th class="text-end pe-4" style="width: 110px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < words.Count; i++)
                            {
                                var word = words[i];
                                var stt = (currentPage - 1) * pageSize + i + 1;
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">@stt</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <button type="button" class="btn btn-sm btn-link p-0 text-primary border-0" title="Nghe phát âm" @onclick="() => SpeakWordAsync(word.Term)">
                                                <i class="bi bi-volume-up-fill fs-6"></i>
                                            </button>
                                            <span class="fw-bold text-primary fs-6">
                                                @word.Term
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(word.Phonetic))
                                        {
                                            <span class="font-monospace text-muted fst-italic small">
                                                @word.Phonetic
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(word.PartOfSpeech))
                                        {
                                            <span class="badge @GetPartOfSpeechBadgeClass(word.PartOfSpeech) rounded-pill small">
                                                @word.PartOfSpeech
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="text-dark" title="@word.Meaning">
                                            @Truncate(word.Meaning, 80)
                                        </span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(word.ExampleSentence))
                                        {
                                            <div class="small text-secondary" title="@($"{word.ExampleSentence}\n→ {word.ExampleTranslation}")">
                                                <em>@Truncate(word.ExampleSentence, 60)</em>
                                                @if (!string.IsNullOrWhiteSpace(word.ExampleTranslation))
                                                {
                                                    <div class="text-muted fst-normal" style="font-size: 0.75rem;">
                                                        @Truncate(word.ExampleTranslation, 50)
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-secondary border">
                                            <i class="bi bi-folder me-1 text-primary"></i>
                                            @(word.Topic?.Name ?? "Chung")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm border-0 p-0" 
                                                @onclick="() => ToggleMasteredAsync(word)" 
                                                title="Bấm để đổi trạng thái" 
                                                disabled="@isToggling">
                                            @if (word.IsMastered)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 cursor-pointer">
                                                    <i class="bi bi-check-circle-fill me-1"></i> Đã thuộc
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3 py-1 cursor-pointer">
                                                    <i class="bi bi-circle me-1"></i> Chưa thuộc
                                                </span>
                                            }
                                        </button>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Sửa từ vựng" @onclick="() => OpenEditModal(word)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" title="Xóa từ vựng" @onclick="() => OpenDeleteModal(word)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- #region: Word List Card Grid (Mobile/Card View) -->
                <div class="p-3 p-md-4 bg-light bg-opacity-50 border-bottom">
                    <div class="row g-3">
                        @for (int i = 0; i < words.Count; i++)
                        {
                            var word = words[i];
                            var stt = (currentPage - 1) * pageSize + i + 1;
                            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                                <div class="card h-100 word-card bg-white shadow-xs @(word.IsMastered ? "border-success border-opacity-25" : "")">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <!-- Top Row: STT, Part of Speech, Topic, Action buttons -->
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div class="d-flex align-items-center gap-1 flex-wrap">
                                                <span class="badge bg-light text-muted border rounded-pill small">#@stt</span>
                                                @if (!string.IsNullOrWhiteSpace(word.PartOfSpeech))
                                                {
                                                    <span class="badge @GetPartOfSpeechBadgeClass(word.PartOfSpeech) rounded-pill small">
                                                        @word.PartOfSpeech
                                                    </span>
                                                }
                                                <span class="badge bg-light text-secondary border rounded-pill small" title="Chủ đề: @(word.Topic?.Name ?? "Chung")">
                                                    <i class="bi bi-folder me-1 text-primary"></i>
                                                    @Truncate(word.Topic?.Name ?? "Chung", 14)
                                                </span>
                                            </div>

                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-secondary border-0 btn-action-touch p-1 text-primary" title="Sửa từ vựng" @onclick="() => OpenEditModal(word)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary border-0 btn-action-touch p-1 text-danger" title="Xóa từ vựng" @onclick="() => OpenDeleteModal(word)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Term, Phonetic and Audio Speaker -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="pe-2">
                                                <div class="fw-bold fs-5 text-primary text-break lh-sm">
                                                    @word.Term
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(word.Phonetic))
                                                {
                                                    <div class="font-monospace text-muted small fst-italic mt-1">
                                                        @word.Phonetic
                                                    </div>
                                                }
                                            </div>
                                            <button type="button" 
                                                    class="btn btn-primary-subtle text-primary btn-audio-touch d-flex align-items-center justify-content-center p-0 flex-shrink-0 shadow-xs" 
                                                    title="Nghe phát âm"
                                                    @onclick="() => SpeakWordAsync(word.Term)">
                                                <i class="bi bi-volume-up-fill fs-5"></i>
                                            </button>
                                        </div>

                                        <!-- Meaning -->
                                        <div class="mb-2 text-dark fw-medium lh-sm" title="@word.Meaning">
                                            @word.Meaning
                                        </div>

                                        <!-- Example Sentence & Translation -->
                                        @if (!string.IsNullOrWhiteSpace(word.ExampleSentence))
                                        {
                                            <div class="p-2 rounded bg-light bg-opacity-75 small border border-light-subtle mb-3 flex-grow-1">
                                                <div class="text-secondary fst-italic">
                                                    “@word.ExampleSentence”
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(word.ExampleTranslation))
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 0.8rem;">
                                                        → @word.ExampleTranslation
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="flex-grow-1"></div>
                                        }

                                        <!-- Mastery Status Button (Full width, easy thumb tapping) -->
                                        <button class="btn btn-sm w-100 rounded-pill d-flex align-items-center justify-content-center gap-2 border btn-mastery-touch @(word.IsMastered ? "btn-success-subtle text-success border-success-subtle" : "btn-light text-secondary border-secondary-subtle")"
                                                @onclick="() => ToggleMasteredAsync(word)" 
                                                title="Chạm để chuyển đổi trạng thái" 
                                                disabled="@isToggling">
                                            @if (word.IsMastered)
                                            {
                                                <i class="bi bi-check-circle-fill text-success fs-6"></i>
                                                <span class="fw-semibold">Đã thuộc</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-circle text-muted fs-6"></i>
                                                <span class="fw-normal">Chưa thuộc (Chạm để đổi)</span>
                                            }
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- #endregion: Word List Card Grid (Mobile/Card View) -->
            }
        }

            <!-- #region: Pagination -->
            @if (totalPages > 1)
            {
                <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
                    <span class="text-muted small">
                        Hiển thị <strong>@(((currentPage - 1) * pageSize) + 1)</strong> - <strong>@(Math.Min(currentPage * pageSize, totalCount))</strong> trong số <strong>@totalCount</strong> từ
                    </span>

                    <nav aria-label="Phân trang từ vựng">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" aria-label="Trang trước">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                            </li>

                            @for (int p = 1; p <= totalPages; p++)
                            {
                                var targetPage = p;
                                @if (p == 1 || p == totalPages || (p >= currentPage - 2 && p <= currentPage + 2))
                                {
                                    <li class="page-item @(p == currentPage ? "active" : "")">
                                        <button class="page-link" @onclick="() => GoToPage(targetPage)">
                                            @p
                                        </button>
                                    </li>
                                }
                                else if (p == currentPage - 3 || p == currentPage + 3)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" aria-label="Trang sau">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            <!-- #endregion: Pagination -->
        }
    </div>
    <!-- #endregion: Word List Table -->
</div>

<!-- #region: Add/Edit Word Modal -->
<WordFormModal IsVisible="@isWordModalVisible"
               EditWord="@selectedWordForEdit"
               Topics="@topics"
               OnSaved="OnWordSaved"
               OnCancelled="() => isWordModalVisible = false" />
<!-- #endregion: Add/Edit Word Modal -->

<!-- #region: Confirm Delete Modal -->
<ConfirmDeleteModal IsVisible="@isDeleteModalVisible"
                    Title="Xác nhận xóa từ vựng"
                    Message="@deleteWarningMessage"
                    ConfirmButtonText="Xóa từ"
                    IsProcessing="@isDeleting"
                    OnConfirm="ConfirmDeleteWordAsync"
                    OnCancel="() => isDeleteModalVisible = false" />
<!-- #endregion: Confirm Delete Modal -->

<!-- #region: Import Modal -->
@if (isImportModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">📥 Import từ vựng từ CSV</h5>
                    <button type="button" class="btn-close" @onclick="CloseImportModal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Vui lòng tải lên file <code>.csv</code> đúng định dạng. Bạn có thể 
                        <a href="#" @onclick:preventDefault @onclick="DownloadTemplateAsync">tải file mẫu tại đây</a>.
                    </p>
                    <div class="mb-3">
                        <InputFile OnChange="LoadImportFile" class="form-control" accept=".csv" />
                    </div>
                    @if (isImporting)
                    {
                        <div class="d-flex align-items-center gap-2 text-primary">
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                            <span>Đang xử lý dữ liệu...</span>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseImportModal" disabled="@isImporting">Đóng</button>
                    <button type="button" class="btn btn-success" @onclick="ProcessImportAsync" disabled="@(importBrowserFile == null || isImporting)">
                        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Bắt đầu Import
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<!-- #endregion: Import Modal -->

@code {
    [SupplyParameterFromQuery] public int? TopicId { get; set; }

    // ─── Data State ─────────────────────────────────────
    private List<Word> words = new();
    private List<Topic> topics = new();
    private bool isLoading = true;
    private bool isToggling = false;

    // ─── Presentation View Mode ─────────────────────────
    private ViewMode currentViewMode = ViewMode.Table;

    // ─── Filters & Pagination ───────────────────────────
    private string searchTerm = string.Empty;
    private int? selectedTopicId;
    private MasteredFilter selectedMasteredFilter = MasteredFilter.All;
    private int currentPage = 1;
    private int pageSize = 20;
    private int totalCount = 0;
    private int totalPages = 1;

    // 300ms debounce timer to avoid excessive API calls during typing
    private System.Timers.Timer? debounceTimer;

    // ─── Alert ──────────────────────────────────────────
    private string? alertMessage;
    private AlertType alertType = AlertType.Success;

    // ─── Modals ─────────────────────────────────────────
    private bool isWordModalVisible = false;
    private Word? selectedWordForEdit;

    private bool isDeleteModalVisible = false;
    private bool isDeleting = false;
    private Word? wordToDelete;
    private string deleteWarningMessage = string.Empty;

    // ─── Import / Export ────────────────────────────────
    private bool isExporting = false;
    private bool isImportModalVisible = false;
    private bool isImporting = false;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? importBrowserFile;

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(searchTerm) || (selectedTopicId.HasValue && selectedTopicId.Value > 0) || selectedMasteredFilter != MasteredFilter.All;

    protected override async Task OnInitializedAsync()
    {
        // Setup debounce timer for search input to reduce server load
        debounceTimer = new System.Timers.Timer(300);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (sender, args) =>
        {
            await InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadWordsAsync();
                StateHasChanged();
            });
        };

        // Apply topic filter from query string if navigated from Topics page
        if (TopicId.HasValue && TopicId.Value > 0)
        {
            selectedTopicId = TopicId.Value;
        }

        await LoadTopicsAsync();
        await LoadWordsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Auto-detect mobile devices (< 768px -> card) or restore user's saved preference
                var modeStr = await JS.InvokeAsync<string>("viewModeHelper.getViewMode", "learnnn_word_view_mode");
                var detectedMode = modeStr == "card" ? ViewMode.Card : ViewMode.Table;
                if (currentViewMode != detectedMode)
                {
                    currentViewMode = detectedMode;
                    StateHasChanged();
                }
            }
            catch
            {
                // Graceful fallback when JSInterop is not available
            }
        }
    }

    private async Task OnViewModeChangedAsync(ViewMode newMode)
    {
        currentViewMode = newMode;
        try
        {
            await JS.InvokeVoidAsync("viewModeHelper.setViewMode", "learnnn_word_view_mode", newMode == ViewMode.Card ? "card" : "table");
        }
        catch
        {
            // Ignore localStorage exceptions (e.g. Safari private browsing)
        }
    }

    private async Task SpeakWordAsync(string term)
    {
        if (!string.IsNullOrWhiteSpace(term))
        {
            try
            {
                await JS.InvokeVoidAsync("studyInterop.speakWord", term, "en-US");
            }
            catch
            {
                // Ignore speech synthesis exceptions
            }
        }
    }

    /// <summary>
    /// Loads all topics for the filter dropdown.
    /// </summary>
    private async Task LoadTopicsAsync()
    {
        try
        {
            topics = await VocabularyService.GetAllTopicsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi tải danh mục chủ đề: {ex.Message}", isSuccess: false);
        }
    }

    /// <summary>
    /// Fetches a paginated word list based on current filter state.
    /// </summary>
    private async Task LoadWordsAsync()
    {
        isLoading = true;
        try
        {
            var filter = new WordFilterModel
            {
                SearchTerm = searchTerm,
                TopicId = selectedTopicId > 0 ? selectedTopicId : null,
                MasteredFilter = selectedMasteredFilter,
                Page = currentPage,
                PageSize = pageSize
            };

            totalCount = await VocabularyService.GetWordCountAsync(filter);
            totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
            if (totalPages == 0) totalPages = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            words = await VocabularyService.GetWordsAsync(filter);
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi khi tải danh sách từ vựng: {ex.Message}", isSuccess: false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnSearchInputChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task ClearSearch()
    {
        searchTerm = string.Empty;
        currentPage = 1;
        await LoadWordsAsync();
    }

    private async Task OnTopicFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            selectedTopicId = val > 0 ? val : null;
            currentPage = 1;
            await LoadWordsAsync();
        }
    }

    private async Task OnMasteredFilterChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int val))
        {
            selectedMasteredFilter = (MasteredFilter)val;
            currentPage = 1;
            await LoadWordsAsync();
        }
    }

    private async Task ResetFilters()
    {
        searchTerm = string.Empty;
        selectedTopicId = null;
        selectedMasteredFilter = MasteredFilter.All;
        currentPage = 1;
        await LoadWordsAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages || page == currentPage) return;
        currentPage = page;
        await LoadWordsAsync();
    }

    /// <summary>
    /// Toggles mastery status with optimistic UI update, reverting on failure.
    /// </summary>
    private async Task ToggleMasteredAsync(Word word)
    {
        if (isToggling) return;
        isToggling = true;

        // Optimistic UI: flip immediately for responsiveness
        word.IsMastered = !word.IsMastered;

        try
        {
            await VocabularyService.ToggleMasteredAsync(word.Id);
        }
        catch (Exception ex)
        {
            // Revert on failure to keep UI consistent with server state
            word.IsMastered = !word.IsMastered;
            ShowAlert($"Lỗi cập nhật trạng thái: {ex.Message}", isSuccess: false);
        }
        finally
        {
            isToggling = false;
        }
    }

    private void OpenAddModal()
    {
        selectedWordForEdit = null;
        isWordModalVisible = true;
    }

    private void OpenEditModal(Word word)
    {
        selectedWordForEdit = word;
        isWordModalVisible = true;
    }

    private async Task OnWordSaved()
    {
        isWordModalVisible = false;
        ShowAlert(selectedWordForEdit == null ? "Đã thêm từ vựng mới thành công!" : "Đã cập nhật từ vựng thành công!", isSuccess: true);
        await LoadWordsAsync();

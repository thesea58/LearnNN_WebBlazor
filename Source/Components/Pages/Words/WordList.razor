@page "/words"

<PageTitle>Danh sách từ vựng - LearnNN</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">📝 Danh sách từ vựng</h2>
            <p class="text-muted mb-0">Quản lý và ôn tập các từ vựng đã lưu trong hệ thống</p>
        </div>
    </div>

    <div class="card border p-5 text-center bg-white rounded-3 shadow-sm">
        <div class="py-4">
            <div class="display-4 mb-3 text-primary">
                <i class="bi bi-tools"></i>
            </div>
            <h4 class="fw-bold">Chức năng đang được phát triển</h4>
            <p class="text-muted mx-auto" style="max-width: 500px;">
                Màn hình danh sách từ vựng với tính năng tìm kiếm, lọc theo chủ đề, phân trang và toggle trạng thái thuộc từ sẽ được triển khai trong <strong>Task 06 – Word List</strong>.
            </p>
            <div class="mt-4">
                <a href="/" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

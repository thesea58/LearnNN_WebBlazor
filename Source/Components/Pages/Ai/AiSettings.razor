@page "/ai/settings"
@rendermode InteractiveServer
@using LearnNN_WebBlazor.Models.Ai
@using LearnNN_WebBlazor.Services.Ai
@using Microsoft.Extensions.Options
@inject IOptions<AiOptions> AiConfigOptions
@inject GeminiApiExecutor ApiExecutor
@inject NavigationManager Navigation

<PageTitle>Cài Đặt AI – AI Settings | LearnNN</PageTitle>

<div class="container py-4" style="max-width: 900px;">
    @* Page Header *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 pb-2 border-bottom">
        <div class="d-flex align-items-center gap-3">
            <span class="fs-1">⚙️</span>
            <div>
                <h2 class="fw-bold mb-0 text-dark">Cài Đặt Hệ Thống AI</h2>
                <p class="text-muted mb-0 small">
                    Quản lý chế độ hoạt động, bảo mật API Key và tùy biến cầu nối chatbot web.
                </p>
            </div>
        </div>
        <div>
            <a href="ai/inbox" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-inbox"></i> Về AI Inbox
            </a>
        </div>
    </div>

    @if (showSavedAlert)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            Đã lưu thay đổi cấu hình phiên làm việc thành công!
            <button type="button" class="btn-close" @onclick="() => showSavedAlert = false"></button>
        </div>
    }

    @* Section 1: AI Operating Mode *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-sliders text-primary"></i> 1. Chế Độ Hoạt Động (AI Operating Mode)
            </h5>
            <p class="text-muted small mb-3">
                Chọn cách thức ứng dụng tương tác với trí tuệ nhân tạo. Bạn có thể đổi chế độ bất cứ lúc nào.
            </p>

            <div class="row g-3">
                @* Manual Mode *@
                <div class="col-md-4">
                    <div class="card h-100 p-3 rounded-3 border-2 @(selectedMode == AiMode.Manual ? "border-primary bg-primary bg-opacity-10" : "border-light bg-light")"
                         style="cursor: pointer;"
                         @onclick="() => selectedMode = AiMode.Manual">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="aiModeRadio" id="modeManual"
                                   checked="@(selectedMode == AiMode.Manual)" />
                            <label class="form-check-label fw-bold text-dark" for="modeManual">
                                🅼 Manual Bridge
                            </label>
                        </div>
                        <div class="small text-muted mt-2">
                            • <strong>100% Miễn phí</strong>, không cần API Key.<br />
                            • Copy prompt sang chatbot web và dán JSON về app.<br />
                            • Khuyên dùng khi muốn dùng bản Gemini Advanced trên web.
                        </div>
                    </div>
                </div>

                @* Hybrid Mode *@
                <div class="col-md-4">
                    <div class="card h-100 p-3 rounded-3 border-2 @(selectedMode == AiMode.Hybrid ? "border-primary bg-primary bg-opacity-10" : "border-light bg-light")"
                         style="cursor: pointer;"
                         @onclick="() => selectedMode = AiMode.Hybrid">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="aiModeRadio" id="modeHybrid"
                                   checked="@(selectedMode == AiMode.Hybrid)" />
                            <label class="form-check-label fw-bold text-dark" for="modeHybrid">
                                🅷 Hybrid (Khuyến nghị)
                            </label>
                        </div>
                        <div class="small text-muted mt-2">
                            • Gọi Gemini API tự động.<br />
                            • Khi hết hạn ngạch (HTTP 429) hoặc mạng yếu, <strong>tự động chuyển sang Manual Bridge</strong> mà không mất bài.<br />
                            • An toàn và linh hoạt nhất.
                        </div>
                    </div>
                </div>

                @* Auto Mode *@
                <div class="col-md-4">
                    <div class="card h-100 p-3 rounded-3 border-2 @(selectedMode == AiMode.Auto ? "border-primary bg-primary bg-opacity-10" : "border-light bg-light")"
                         style="cursor: pointer;"
                         @onclick="() => selectedMode = AiMode.Auto">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="aiModeRadio" id="modeAuto"
                                   checked="@(selectedMode == AiMode.Auto)" />
                            <label class="form-check-label fw-bold text-dark" for="modeAuto">
                                🅰 Auto (Gemini API)
                            </label>
                        </div>
                        <div class="small text-muted mt-2">
                            • Tự động 100% qua Google AI Studio API.<br />
                            • Cần cấu hình API Key.<br />
                            • Phản hồi tức thì, không cần thao tác copy/dán.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Section 2: API Key Security & Management *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-shield-lock-fill text-success"></i> 2. Quản Lý & Bảo Mật API Key
                </h5>
                @if (hasApiKey)
                {
                    <span class="badge bg-success px-3 py-2 fs-6">
                        <i class="bi bi-check-circle-fill me-1"></i> Đã cấu hình API Key
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary px-3 py-2 fs-6">
                        <i class="bi bi-exclamation-circle me-1"></i> Chưa cấu hình API Key
                    </span>
                }
            </div>

            @if (hasApiKey)
            {
                @* Masked Key Safe Display *@
                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold text-secondary">
                            <i class="bi bi-key-fill text-warning me-1"></i> Khóa API hiện hành (Đã ẩn bảo mật):
                        </span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 0.75rem;">
                            <i class="bi bi-shield-shaded"></i> Bảo mật máy chủ (Zero Leakage)
                        </span>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-2">
                        <span class="font-monospace fs-6 px-3 py-2 bg-white rounded border flex-grow-1 text-dark user-select-none" style="letter-spacing: 1px; word-break: break-all;">
                            @maskedCurrentKey
                        </span>
                        <button class="btn btn-outline-primary d-flex align-items-center gap-1 px-3 py-2"
                                type="button"
                                disabled="@isTestingConnection"
                                @onclick="TestConnectionAsync">
                            @if (isTestingConnection)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Đang test...</span>
                            }
                            else
                            {
                                <i class="bi bi-broadcast"></i>
                                <span>Kiểm Tra Kết Nối</span>
                            }
                        </button>
                    </div>
                    <div class="text-muted mt-2 small" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle me-1"></i> Vì lý do an toàn tuyệt đối, hệ thống chỉ hiển thị 4 ký tự đầu và 4 ký tự cuối. Trình duyệt (F12 / Inspect / Copy) hoàn toàn không thể trích xuất chuỗi key gốc.
                    </div>
                </div>
            }

            @* Input to enter or change key *@
            <div class="mb-3">
                <label class="form-label fw-semibold text-dark small mb-1">
                    @(hasApiKey ? "Thay đổi API Key mới (Để trống nếu tiếp tục dùng key hiện tại):" : "Google AI Studio (Gemini) API Key:")
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-shield-lock text-muted"></i></span>
                    <input type="password"
                           class="form-control font-monospace"
                           placeholder="@(hasApiKey ? "•••••••••••••••••••• (Dán key mới để thay thế...)" : "Dán API Key tại đây để kích hoạt...")"
                           autocomplete="off"
                           @bind="newApiKeyInput"
                           @bind:event="oninput" />
                    @if (!hasApiKey)
                    {
                        <button class="btn btn-outline-primary d-flex align-items-center gap-1"
                                type="button"
                                disabled="@(isTestingConnection || string.IsNullOrWhiteSpace(newApiKeyInput))"
                                @onclick="TestConnectionAsync">
                            @if (isTestingConnection)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Đang test...</span>
                            }
                            else
                            {
                                <i class="bi bi-broadcast"></i>
                                <span>Kiểm Tra Kết Nối</span>
                            }
                        </button>
                    }
                </div>
                <div class="form-text small text-muted">
                    Lấy API Key miễn phí tại <a href="https://aistudio.google.com/app/apikey" target="_blank" class="text-decoration-none">Google AI Studio <i class="bi bi-box-arrow-up-right"></i></a>. Key nhập trực tiếp sẽ được bảo vệ ngay khi bấm Lưu Cấu Hình.
                </div>
            </div>

            @if (testResult != null)
            {
                <div class="alert @(testResult.Value.IsSuccess ? "alert-success" : "alert-danger") alert-dismissible fade show p-2 px-3 small mb-3" role="alert">
                    <i class="bi @(testResult.Value.IsSuccess ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill") me-1"></i>
                    @testResult.Value.Message
                    <button type="button" class="btn-close p-2" @onclick="() => testResult = null"></button>
                </div>
            }

            @* Security Guarantee Note *@
            <div class="alert alert-info border-0 rounded-3 p-3 small mb-3">
                <div class="fw-bold d-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-shield-check fs-5"></i> Cam kết bảo mật GitHub:
                </div>
                <div>
                    Để tránh tuyệt đối nguy cơ rò rỉ API Key lên GitHub hoặc các kho lưu trữ mã nguồn mở,
                    LearnNN không lưu API Key dạng văn bản thuần trong file `appsettings.json`.
                    Hệ thống tự động nạp key an toàn qua <strong>Biến môi trường</strong>, file <strong>.env</strong>, hoặc <strong>.NET User Secrets</strong>.
                </div>
            </div>

            <div class="bg-light p-3 rounded-3 small">
                <div class="fw-semibold text-dark mb-2">Các cách cấu hình biến môi trường tự động nhận (không lo lộ key):</div>
                
                <div class="mb-3">
                    <span class="badge bg-primary text-wrap text-start">Cách 1 (PowerShell - Lưu vĩnh viễn trên Windows):</span>
                    <pre class="bg-dark text-light p-2 rounded mt-1 mb-0 font-monospace" style="white-space: pre-wrap; word-break: break-all;">[System.Environment]::SetEnvironmentVariable('GEMINI_API_KEY', 'AIzaSy...', 'User')</pre>
                    <div class="text-muted mt-1" style="font-size: 0.78rem;">
                        <i class="bi bi-info-circle"></i> Lệnh này lưu key vào Windows User Registry. Khởi động lại terminal/app để nhận biến.
                    </div>
                </div>

                <div class="mb-3">
                    <span class="badge bg-secondary text-wrap text-start">Cách 2 (File .env ở thư mục gốc dự án):</span>
                    <pre class="bg-dark text-light p-2 rounded mt-1 mb-0 font-monospace" style="white-space: pre-wrap; word-break: break-all;">GEMINI_API_KEY=AIzaSy...</pre>
                    <div class="text-muted mt-1" style="font-size: 0.78rem;">
                        <i class="bi bi-check2-circle text-success"></i> File <code>.env</code> đã được cấu hình trong <code>.gitignore</code>, không bao giờ bị đẩy lên GitHub.
                    </div>
                </div>

                <div class="mb-3">
                    <span class="badge bg-dark text-wrap text-start">Cách 3 (.NET User Secrets - Khuyến nghị cho lập trình viên .NET):</span>
                    <pre class="bg-dark text-light p-2 rounded mt-1 mb-0 font-monospace" style="white-space: pre-wrap; word-break: break-all;">dotnet user-secrets set "Ai:ApiKey" "AIzaSy..." --project Source</pre>
                </div>

                <div>
                    <span class="badge bg-secondary text-wrap text-start">Cách 4 (Windows Command Prompt - CMD):</span>
                    <pre class="bg-dark text-light p-2 rounded mt-1 mb-0 font-monospace" style="white-space: pre-wrap; word-break: break-all;">setx GEMINI_API_KEY "AIzaSy..."</pre>
                </div>
            </div>
        </div>
    </div>

    @* Section 3: Web Chatbot URL (For Manual Bridge) *@
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold text-dark mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-globe text-info"></i> 3. Chatbot Web Mở Nhanh (Dành cho Manual Bridge)
            </h5>
            <p class="text-muted small mb-3">
                Khi bạn bấm nút "Mở Chatbot Web" trong Modal, trình duyệt sẽ tự động bật tab mới tới địa chỉ này:
            </p>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <button type="button" class="btn btn-sm @(selectedChatbotUrl == "https://gemini.google.com/" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => selectedChatbotUrl = "https://gemini.google.com/"'>
                    Google Gemini Web
                </button>
                <button type="button" class="btn btn-sm @(selectedChatbotUrl == "https://chatgpt.com/" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => selectedChatbotUrl = "https://chatgpt.com/"'>
                    ChatGPT
                </button>
                <button type="button" class="btn btn-sm @(selectedChatbotUrl == "https://claude.ai/" ? "btn-primary" : "btn-outline-secondary")"
                        @onclick='() => selectedChatbotUrl = "https://claude.ai/"'>
                    Claude AI
                </button>
            </div>

            <div class="input-group shadow-sm">
                <span class="input-group-text bg-white"><i class="bi bi-link-45deg"></i></span>
                <input type="text" class="form-control" @bind="selectedChatbotUrl" placeholder="https://gemini.google.com/" />
            </div>
        </div>
    </div>

    @* Save Button *@
    <div class="d-flex justify-content-end gap-2 mb-5">
        <button class="btn btn-primary px-4 fw-semibold shadow-sm d-flex align-items-center gap-2" @onclick="SaveSettings">
            <i class="bi bi-check-lg"></i> Lưu Cấu Hình
        </button>
    </div>
</div>

@code {
    private AiMode selectedMode;
    private string selectedChatbotUrl = "https://gemini.google.com/";
    private bool hasApiKey = false;
    private bool showSavedAlert = false;
    private string maskedCurrentKey = string.Empty;
    private string newApiKeyInput = string.Empty;
    private bool isTestingConnection = false;
    private (bool IsSuccess, string Message)? testResult = null;

    protected override void OnInitialized()
    {
        var config = AiConfigOptions.Value;
        selectedMode = config.Mode;
        selectedChatbotUrl = !string.IsNullOrWhiteSpace(config.PreferredChatbotUrl)
            ? config.PreferredChatbotUrl
            : "https://gemini.google.com/";
        hasApiKey = config.HasApiKey;
        if (hasApiKey)
        {
            maskedCurrentKey = FormatMaskedKey(config.ApiKey);
        }
        newApiKeyInput = string.Empty;
    }

    private static string FormatMaskedKey(string? rawKey)
    {
        if (string.IsNullOrWhiteSpace(rawKey)) return string.Empty;
        var clean = rawKey.Trim('"', '\'', ' ');
        if (clean.Length <= 8)
        {
            return "••••••••";
        }
        return $"{clean[..4]}••••••••••••{clean[^4..]}";
    }

    private async Task TestConnectionAsync()
    {
        if (isTestingConnection) return;
        isTestingConnection = true;
        testResult = null;
        StateHasChanged();

        try
        {
            // If the user typed a new key to test, use that. Otherwise test the server's configured key.
            string keyToTest = !string.IsNullOrWhiteSpace(newApiKeyInput)
                ? newApiKeyInput.Trim('"', '\'', ' ')
                : (AiConfigOptions.Value.ApiKey ?? string.Empty);

            testResult = await ApiExecutor.TestConnectionAsync(keyToTest);
        }
        finally
        {
            isTestingConnection = false;
        }
    }

    private void SaveSettings()
    {
        if (!string.IsNullOrWhiteSpace(newApiKeyInput))
        {
            var cleanKey = newApiKeyInput.Trim('"', '\'', ' ');
            AiConfigOptions.Value.ApiKey = cleanKey;
            maskedCurrentKey = FormatMaskedKey(cleanKey);
            newApiKeyInput = string.Empty; // Zero-out the input immediately after saving
            hasApiKey = true;

            // Auto-upgrade to Hybrid if previously Manual
            if (selectedMode == AiMode.Manual)
            {
                selectedMode = AiMode.Hybrid;
            }
        }

        AiConfigOptions.Value.Mode = selectedMode;
        AiConfigOptions.Value.PreferredChatbotUrl = selectedChatbotUrl;
        hasApiKey = AiConfigOptions.Value.HasApiKey;
        showSavedAlert = true;
    }
}

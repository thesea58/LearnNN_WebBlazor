@page "/topics"
@rendermode InteractiveServer
@inject IVocabularyService VocabularyService
@inject IJSRuntime JS

<PageTitle>Quản lý chủ đề - LearnNN 📁</PageTitle>

<div class="container-fluid p-0">
    <!-- #region: Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-folder2-open text-primary me-2"></i>Quản lý Chủ đề
            </h2>
            <p class="text-muted mb-0">Phân loại và gom nhóm từ vựng theo từng chủ đề học tập</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 py-2 shadow-sm d-flex align-items-center gap-2" @onclick="OpenAddModal">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Thêm chủ đề mới</span>
        </button>
    </div>
    <!-- #endregion: Page Header -->

    <!-- #region: Alert Notification -->
    <AlertMessage Message="@alertMessage"
                  Type="@alertType"
                  IsVisible="@(!string.IsNullOrEmpty(alertMessage))"
                  OnDismiss="() => alertMessage = null" />
    <!-- #endregion: Alert Notification -->

    <!-- #region: Topic List Table -->
    <div class="card border rounded-3 bg-white shadow-sm overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi @(currentViewMode == ViewMode.Table ? "bi-list-ul" : "bi-grid-fill") me-2 text-primary"></i>Danh sách chủ đề
                </h6>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                    @topics.Count chủ đề
                </span>
            </div>
            <ViewModeSwitcher CurrentMode="@currentViewMode" CurrentModeChanged="OnViewModeChangedAsync" />
        </div>

        @if (isLoading)
        {
            <LoadingSpinner IsVisible="@isLoading" Message="Đang tải danh sách chủ đề..." />
        }
        else if (!topics.Any())
        {
            <div class="p-5 text-center">
                <div class="display-6 text-muted mb-3">
                    <i class="bi bi-folder-x"></i>
                </div>
                <h5 class="fw-bold text-dark">Chưa có chủ đề nào</h5>
                <p class="text-muted mx-auto mb-4" style="max-width: 420px;">
                    Hãy bắt đầu bằng cách tạo chủ đề đầu tiên để tổ chức và phân loại các từ vựng học tập của bạn!
                </p>
                <button class="btn btn-outline-primary rounded-pill px-4" @onclick="OpenAddModal">
                    <i class="bi bi-plus-lg me-1"></i> Tạo chủ đề ngay
                </button>
            </div>
        }
        else
        {
            @if (currentViewMode == ViewMode.Table)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 60px;">#</th>
                                <th style="min-width: 180px;">Tên chủ đề</th>
                                <th style="min-width: 250px;">Mô tả</th>
                                <th class="text-center" style="width: 120px;">Số từ</th>
                                <th style="width: 140px;">Ngày tạo</th>
                                <th class="text-end pe-4" style="width: 150px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < topics.Count; i++)
                            {
                                var topic = topics[i];
                                var index = i + 1;
                                var wordCount = topic.Words?.Count ?? 0;
                                <tr>
                                    <td class="ps-4 text-muted fw-semibold">@index</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="p-2 rounded bg-primary-subtle text-primary d-inline-flex">
                                                <i class="bi bi-folder-fill"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@topic.Name</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-secondary">
                                            @(string.IsNullOrWhiteSpace(topic.Description) ? "—" : topic.Description)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a href="/words?topicId=@topic.Id" class="badge rounded-pill text-decoration-none @(wordCount > 0 ? "bg-primary-subtle text-primary border border-primary-subtle" : "bg-light text-secondary border") px-3 py-1">
                                            <i class="bi bi-journal-text me-1"></i> @wordCount từ
                                        </a>
                                    </td>
                                    <td>
                                        <span class="text-muted small">
                                            <i class="bi bi-calendar3 me-1"></i>
                                            @topic.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" title="Sửa chủ đề" @onclick="() => OpenEditModal(topic)">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-outline-danger" title="Xóa chủ đề" @onclick="() => OpenDeleteModal(topic)">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <!-- #region: Topic List Card Grid (Mobile/Card View) -->
                <div class="p-3 p-md-4 bg-light bg-opacity-50 border-bottom">
                    <div class="row g-3">
                        @for (int i = 0; i < topics.Count; i++)
                        {
                            var topic = topics[i];
                            var index = i + 1;
                            var wordCount = topic.Words?.Count ?? 0;
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card h-100 topic-card bg-white shadow-xs border">
                                    <div class="card-body p-3 d-flex flex-column">
                                        <!-- Header: Folder Icon & Topic Name & Actions -->
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="d-flex align-items-center gap-2 pe-2">
                                                <div class="p-2 rounded-3 bg-primary-subtle text-primary d-inline-flex flex-shrink-0">
                                                    <i class="bi bi-folder-fill fs-5"></i>
                                                </div>
                                                <div>
                                                    <span class="badge bg-light text-muted border rounded-pill small me-1">#@index</span>
                                                    <h6 class="fw-bold text-dark mb-0 d-inline">@topic.Name</h6>
                                                </div>
                                            </div>

                                            <div class="btn-group btn-group-sm flex-shrink-0">
                                                <button class="btn btn-outline-secondary border-0 btn-action-touch p-1 text-primary" title="Sửa chủ đề" @onclick="() => OpenEditModal(topic)">
                                                    <i class="bi bi-pencil-square"></i>
                                                </button>
                                                <button class="btn btn-outline-secondary border-0 btn-action-touch p-1 text-danger" title="Xóa chủ đề" @onclick="() => OpenDeleteModal(topic)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Description -->
                                        <p class="text-secondary small mb-3 flex-grow-1">
                                            @(string.IsNullOrWhiteSpace(topic.Description) ? "Chưa có mô tả cho chủ đề này." : topic.Description)
                                        </p>

                                        <!-- Footer info: Word count badge and Created date -->
                                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                            <a href="/words?topicId=@topic.Id" 
                                               class="btn btn-sm rounded-pill text-decoration-none @(wordCount > 0 ? "btn-primary-subtle text-primary border border-primary-subtle" : "btn-light text-secondary border") px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1"
                                               title="Xem danh sách từ của chủ đề này">
                                                <i class="bi bi-journal-text"></i>
                                                <span>@wordCount từ vựng</span>
                                            </a>

                                            <span class="text-muted small">
                                                <i class="bi bi-calendar3 me-1"></i>
                                                @topic.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- #endregion: Topic List Card Grid (Mobile/Card View) -->
            }
        }
    </div>
    <!-- #endregion: Topic List Table -->
</div>

<!-- #region: Add/Edit Topic Modal -->
@if (isFormModalVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background-color: rgba(15, 23, 42, 0.5); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-primary-subtle p-2 text-primary d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                            <i class="bi @(isEditing ? "bi-pencil-fill" : "bi-folder-plus") fs-5"></i>
                        </div>
                        <h5 class="modal-title fw-bold text-dark mb-0">
                            @(isEditing ? "Chỉnh sửa chủ đề" : "Thêm chủ đề mới")
                        </h5>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseFormModal" disabled="@isSubmitting"></button>
                </div>
                
                <div class="modal-body px-4 py-3">
                    @if (!string.IsNullOrEmpty(formErrorMessage))
                    {
                        <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center">
                            <i class="bi bi-exclamation-circle-fill me-2 fs-6"></i>
                            <div>@formErrorMessage</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-dark small mb-1">
                            Tên chủ đề <span class="text-danger">*</span>
                        </label>
                        <input type="text" 
                               class="form-control @(nameValidationClass)" 
                               placeholder="Ví dụ: Công nghệ, Du lịch, IELTS..." 
                               maxlength="100" 
                               @bind="formModel.Name" 
                               @bind:event="oninput" 
                               disabled="@isSubmitting" />
                        <div class="form-text small">Tối đa 100 ký tự. Không được trùng với chủ đề khác.</div>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold text-dark small mb-1">Mô tả (tùy chọn)</label>
                        <textarea class="form-control" 
                                  rows="3" 
                                  placeholder="Mô tả nội dung, mục tiêu của chủ đề này..." 
                                  maxlength="250" 
                                  @bind="formModel.Description" 
                                  disabled="@isSubmitting"></textarea>
                        <div class="form-text small">Tối đa 250 ký tự.</div>
                    </div>
                </div>

                <div class="modal-footer bg-light bg-opacity-50 border-top-0 px-4 pb-4 pt-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-3" @onclick="CloseFormModal" disabled="@isSubmitting">
                        <i class="bi bi-x me-1"></i> Hủy
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="SaveTopicAsync" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg me-1"></i>
                            <span>@(isEditing ? "Cập nhật" : "Tạo chủ đề")</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<!-- #endregion: Add/Edit Topic Modal -->

<!-- #region: Confirm Delete Modal -->
<ConfirmDeleteModal IsVisible="@isDeleteModalVisible"
                    Title="Xác nhận xóa chủ đề"
                    Message="@deleteWarningMessage"
                    ConfirmButtonText="Xóa chủ đề"
                    IsProcessing="@isDeleting"
                    OnConfirm="ConfirmDeleteTopicAsync"
                    OnCancel="() => isDeleteModalVisible = false" />
<!-- #endregion: Confirm Delete Modal -->

@code {
    // ─── State ──────────────────────────────────────────
    private List<Topic> topics = new();
    private bool isLoading = true;

    // ─── Presentation View Mode ─────────────────────────
    private ViewMode currentViewMode = ViewMode.Table;

    // ─── Alert ──────────────────────────────────────────
    private string? alertMessage;
    private AlertType alertType = AlertType.Success;

    // ─── Form Modal ─────────────────────────────────────
    private bool isFormModalVisible = false;
    private bool isEditing = false;
    private bool isSubmitting = false;
    private string? formErrorMessage;
    private string nameValidationClass = "";
    private TopicFormModel formModel = new();

    // ─── Delete Modal ───────────────────────────────────
    private bool isDeleteModalVisible = false;
    private bool isDeleting = false;
    private Topic? topicToDelete;
    private string deleteWarningMessage = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadTopicsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                // Auto-detect mobile devices (< 768px -> card) or restore user's saved preference
                var modeStr = await JS.InvokeAsync<string>("viewModeHelper.getViewMode", "learnnn_topic_view_mode");
                var detectedMode = modeStr == "card" ? ViewMode.Card : ViewMode.Table;
                if (currentViewMode != detectedMode)
                {
                    currentViewMode = detectedMode;
                    StateHasChanged();
                }
            }
            catch
            {
                // Graceful fallback when JSInterop is not available
            }
        }
    }

    private async Task OnViewModeChangedAsync(ViewMode newMode)
    {
        currentViewMode = newMode;
        try
        {
            await JS.InvokeVoidAsync("viewModeHelper.setViewMode", "learnnn_topic_view_mode", newMode == ViewMode.Card ? "card" : "table");
        }
        catch
        {
            // Ignore localStorage exceptions (e.g. Safari private browsing)
        }
    }

    /// <summary>
    /// Fetches all topics from the service and updates the table.
    /// </summary>
    private async Task LoadTopicsAsync()
    {
        isLoading = true;
        try
        {
            topics = await VocabularyService.GetAllTopicsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi tải danh sách chủ đề: {ex.Message}", isSuccess: false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenAddModal()
    {
        isEditing = false;
        formErrorMessage = null;
        nameValidationClass = "";
        formModel = new TopicFormModel();
        isFormModalVisible = true;
    }

    private void OpenEditModal(Topic topic)
    {
        isEditing = true;
        formErrorMessage = null;
        nameValidationClass = "";
        formModel = new TopicFormModel
        {
            Id = topic.Id,
            Name = topic.Name,
            Description = topic.Description
        };
        isFormModalVisible = true;
    }

    private void CloseFormModal()
    {
        if (!isSubmitting)
        {
            isFormModalVisible = false;
            formErrorMessage = null;
        }
    }

    /// <summary>
    /// Validates input and persists the topic (create or update).
    /// </summary>
    private async Task SaveTopicAsync()
    {
        var trimmedName = formModel.Name?.Trim() ?? string.Empty;

        // A. Client-side validation
        if (string.IsNullOrWhiteSpace(trimmedName))
        {
            formErrorMessage = "Tên chủ đề không được để trống.";
            nameValidationClass = "is-invalid";
            return;
        }

        if (trimmedName.Length > 100)
        {
            formErrorMessage = "Tên chủ đề tối đa 100 ký tự.";
            nameValidationClass = "is-invalid";
            return;
        }

        isSubmitting = true;
        formErrorMessage = null;
        nameValidationClass = "";

        try
        {
            // B. Check for duplicate name (excluding current entity during edit)
            int? excludeId = isEditing ? formModel.Id : null;
            bool exists = await VocabularyService.TopicNameExistsAsync(trimmedName, excludeId);
            if (exists)
            {
                formErrorMessage = $"Chủ đề có tên '{trimmedName}' đã tồn tại. Vui lòng chọn tên khác.";
                nameValidationClass = "is-invalid";
                isSubmitting = false;
                return;
            }

            // C. Persist changes
            if (isEditing)
            {
                var topic = new Topic
                {
                    Id = formModel.Id,
                    Name = trimmedName,
                    Description = formModel.Description?.Trim()
                };
                await VocabularyService.UpdateTopicAsync(topic);
                ShowAlert($"Đã cập nhật chủ đề '{trimmedName}' thành công!", isSuccess: true);
            }
            else
            {
                var topic = new Topic
                {
                    Name = trimmedName,
                    Description = formModel.Description?.Trim()
                };
                await VocabularyService.CreateTopicAsync(topic);
                ShowAlert($"Đã thêm chủ đề mới '{trimmedName}' thành công!", isSuccess: true);
            }

            isFormModalVisible = false;
            await LoadTopicsAsync();
        }
        catch (Exception ex)
        {
            formErrorMessage = $"Lỗi khi lưu chủ đề: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    /// <summary>
    /// Prepares the delete confirmation modal with a cascade warning if the topic has words.
    /// </summary>
    private void OpenDeleteModal(Topic topic)
    {
        topicToDelete = topic;
        var wordCount = topic.Words?.Count ?? 0;

        if (wordCount > 0)
        {
            deleteWarningMessage = $"⚠️ Cảnh báo: Chủ đề '{topic.Name}' đang có {wordCount} từ vựng. Xóa chủ đề này sẽ ĐỒNG THỜI XÓA VĨNH VIỄN toàn bộ {wordCount} từ vựng liên quan!";
        }
        else
        {
            deleteWarningMessage = $"Bạn có chắc chắn muốn xóa chủ đề '{topic.Name}' không? Thao tác này không thể hoàn tác.";
        }

        isDeleteModalVisible = true;
    }

    private async Task ConfirmDeleteTopicAsync()
    {
        if (topicToDelete == null) return;

        isDeleting = true;
        try
        {
            var name = topicToDelete.Name;
            await VocabularyService.DeleteTopicAsync(topicToDelete.Id);
            isDeleteModalVisible = false;
            topicToDelete = null;
            ShowAlert($"Đã xóa chủ đề '{name}' thành công!", isSuccess: true);
            await LoadTopicsAsync();
        }
        catch (Exception ex)
        {
            ShowAlert($"Lỗi khi xóa chủ đề: {ex.Message}", isSuccess: false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowAlert(string message, bool isSuccess)
    {
        alertMessage = message;
        alertType = isSuccess ? AlertType.Success : AlertType.Error;
    }

    /// <summary>
    /// Internal form model for topic add/edit modal, decoupled from the entity to avoid tracking issues.
    /// <para>VN: Model form nội bộ cho modal thêm/sửa chủ đề, tách biệt khỏi entity để tránh lỗi EF tracking.</para>
    /// </summary>
    public class TopicFormModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string? Description { get; set; }
    }
}

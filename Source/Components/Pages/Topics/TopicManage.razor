@page "/topics"

<PageTitle>Quản lý chủ đề - LearnNN</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">📁 Quản lý chủ đề</h2>
            <p class="text-muted mb-0">Phân loại và gom nhóm từ vựng theo từng chủ đề học tập</p>
        </div>
    </div>

    <div class="card border p-5 text-center bg-white rounded-3 shadow-sm">
        <div class="py-4">
            <div class="display-4 mb-3 text-primary">
                <i class="bi bi-folder-plus"></i>
            </div>
            <h4 class="fw-bold">Chức năng đang được phát triển</h4>
            <p class="text-muted mx-auto" style="max-width: 500px;">
                Màn hình quản lý chủ đề với tính năng thêm, sửa, xóa và kiểm tra trùng tên chủ đề sẽ được triển khai trong <strong>Task 05 – Topic Management</strong>.
            </p>
            <div class="mt-4">
                <a href="/" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>

@using LearnNN_WebBlazor.Services.Ai
@inject IAiService AiService

<div class="top-row ps-3 pe-3 navbar navbar-dark">
    <div class="container-fluid d-flex align-items-center justify-content-between p-0">
        <a class="navbar-brand d-flex align-items-center gap-2 m-0" href="">
            <span class="brand-icon">📘</span>
            <span class="brand-text fw-bold">LearnNN</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column p-2">
        <div class="nav-item">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door me-2" aria-hidden="true"></i>
                <span>Trang chủ</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="study">
                <i class="bi bi-mortarboard-fill me-2" aria-hidden="true"></i>
                <span>Học từ vựng</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="words">
                <i class="bi bi-journal-text me-2" aria-hidden="true"></i>
                <span>Từ vựng</span>
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="topics">
                <i class="bi bi-folder2-open me-2" aria-hidden="true"></i>
                <span>Chủ đề</span>
            </NavLink>
        </div>

        <div class="nav-item mt-2 pt-2 border-top border-secondary border-opacity-25">
            <NavLink class="nav-link d-flex align-items-center" href="ai/inbox">
                <i class="bi bi-inbox me-2" aria-hidden="true"></i>
                <span>AI Inbox</span>
                @if (pendingCount > 0)
                {
                    <span class="badge bg-danger rounded-pill ms-auto">@pendingCount</span>
                }
            </NavLink>
        </div>

        <div class="nav-item">
            <NavLink class="nav-link" href="ai/settings">
                <i class="bi bi-gear me-2" aria-hidden="true"></i>
                <span>Cài đặt AI</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private int pendingCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            pendingCount = await AiService.GetPendingRequestCountAsync();
        }
        catch
        {
            pendingCount = 0;
        }
    }
}

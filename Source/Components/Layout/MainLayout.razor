@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="d-flex flex-column min-vh-100 @(isStudySession ? "study-session" : "")">
        <header class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                @if (isStudySession)
                {
                    <a href="/study" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1 d-inline-flex d-lg-none align-items-center gap-1 shadow-xs">
                        <i class="bi bi-x-lg"></i>
                        <span>Thoát</span>
                    </a>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold d-none d-lg-inline-flex align-items-center">
                        <i class="bi bi-mortarboard-fill me-1"></i> Không gian học tập
                    </span>
                }
                else
                {
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 fw-semibold">
                        <i class="bi bi-mortarboard-fill me-1"></i> Không gian học tập
                    </span>
                }
            </div>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small d-none d-sm-inline">
                    <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
                </span>
            </div>
        </header>

        <article class="content px-3 px-md-4 py-3 flex-grow-1">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="alert alert-danger rounded-4 p-4 my-3 shadow-sm" role="alert">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-exclamation-triangle-fill fs-4 text-danger"></i>
                            <h5 class="alert-heading fw-bold mb-0">Đã xảy ra sự cố không mong muốn</h5>
                        </div>
                        <p class="text-secondary small mb-3">
                            Trang gặp phải sự cố trong quá trình kết xuất dữ liệu. Bạn có thể nhấn thử lại hoặc quay về trang chủ.
                        </p>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => errorBoundary?.Recover()">
                                <i class="bi bi-arrow-clockwise me-1"></i> Thử lại
                            </button>
                            <a href="/" class="btn btn-danger btn-sm rounded-pill px-3">
                                <i class="bi bi-house-door me-1"></i> Về Trang chủ
                            </a>
                        </div>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </article>

        <footer class="app-footer text-muted border-top px-4 py-3 text-center text-md-start">
            <div class="container-fluid p-0 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <span class="small">
                    <strong>LearnNN</strong> &copy; @DateTime.Now.Year • Ứng dụng Quản lý Từ vựng tiếng Anh
                </span>
                <span class="small badge bg-white text-secondary border">
                    Phiên bản 1.0.0
                </span>
            </div>
        </footer>

        <MobileBottomNav />
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã có lỗi xảy ra.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private ErrorBoundary? errorBoundary;
    private string currentUri = string.Empty;

    private bool isStudySession =>
        currentUri.Contains("/study/flashcards", StringComparison.OrdinalIgnoreCase) ||
        currentUri.Contains("/study/match", StringComparison.OrdinalIgnoreCase) ||
        currentUri.Contains("/study/scramble", StringComparison.OrdinalIgnoreCase) ||
        currentUri.Contains("/study/quiz", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        currentUri = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override void OnParametersSet()
    {
        // Automatically reset the error boundary whenever routing or parameters update
        errorBoundary?.Recover();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = e.Location;
        StateHasChanged();
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}

